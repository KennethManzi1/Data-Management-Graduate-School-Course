        <mxCell id="UerNysRuGrNKIbmbH3ka-92" edge="1" parent="1" style="endArrow=classic;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" target="UerNysRuGrNKIbmbH3ka-83" value="">
